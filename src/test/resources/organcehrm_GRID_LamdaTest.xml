<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >

<suite name="OrangeHRM - UI Automation Test" verbose="1" >
    <listeners>
        <listener class-name="core.MethodListener"></listener>
    </listeners>
<!--    <parameter name="appUrl" value="https://opensource-demo.orangehrmlive.com/web/index.php/auth/login"></parameter>-->
    <parameter name="server" value="DEV"></parameter>
    <test name="Run on FIREFOX - LINUX">
        <parameter name="os" value="Linux" />
        <parameter name="browser" value="firefox" />
        <parameter name="browser_version" value="131" />
        <classes>
            <class name="com.orangehrm.Level_28_LamdaTest" />
        </classes>
    </test>

    <test name="Run on CHROME - Windows 11">
        <parameter name="os" value="Windows 11" />
        <parameter name="browser" value="chrome" />
        <parameter name="browser_version" value="129" />
        <classes>
            <class name="com.orangehrm.Level_28_LamdaTest" />
        </classes>
    </test>

    <test name="Run on EDGE - Windows 10">
        <parameter name="os" value="Windows 10" />
        <parameter name="browser" value="edge" />
        <parameter name="browser_version" value="129" />
        <classes>
            <class name="com.orangehrm.Level_28_LamdaTest" />
        </classes>
    </test>

    <test name="Run on SAFARI - MAC SONOMA">
        <parameter name="os" value="macOS Sonoma" />
        <parameter name="browser" value="safari" />
        <parameter name="browser_version" value="17" />
        <classes>
            <class name="com.orangehrm.Level_28_LamdaTest" />
        </classes>
    </test>
</suite>