<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >

<suite name="OrangeHRM - UI Automation Test" verbose="1" >
    <listeners>
        <listener class-name="core.MethodListener"></listener>
    </listeners>
<!--    <parameter name="appUrl" value="https://opensource-demo.orangehrmlive.com/web/index.php/auth/login"></parameter>-->
    <parameter name="server" value="DEV"></parameter>
    <test name="Run on Chrome browser" >
        <parameter name="browser" value="chrome"></parameter>
        <parameter name="osName" value="windown"></parameter>
        <parameter name="ipAddress" value="192.168.1.28"></parameter>
        <parameter name="port" value="444"></parameter>
        <classes>
            <class name="com.orangehrm.Level_27_SeleniumGRID"/>
        </classes>
    </test>

    <test name="Run on Chrome edge" >
        <parameter name="browser" value="egde"></parameter>
        <parameter name="osName" value="windown"></parameter>
        <parameter name="ipAddress" value="192.168.1.28"></parameter>
        <parameter name="port" value="444"></parameter>
        <classes>
            <class name="com.orangehrm.Level_27_SeleniumGRID"/>
        </classes>
   </test>
</suite>