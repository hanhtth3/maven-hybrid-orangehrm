<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >

<suite name="OrangeHRM - UI Automation Test" verbose="1" >
    <listeners>
        <listener class-name="core.MethodListener"></listener>
    </listeners>
<!--    <parameter name="appUrl" value="https://opensource-demo.orangehrmlive.com/web/index.php/auth/login"></parameter>-->
    <parameter name="server" value="DEV"></parameter>
    <test name="Run on Chrome browser" >
        <parameter name="browserName" value="Chrome"></parameter>
        <parameter name="osName" value="Windows"></parameter>
        <parameter name="browserVersion" value="148.0"></parameter>
        <parameter name="osVersion" value="11"></parameter>
        <classes>
            <class name="com.orangehrm.Level_28_BrowserStack"/>
        </classes>
    </test>
</suite>